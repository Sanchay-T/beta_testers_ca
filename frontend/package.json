{
  "name": "cyphersol-electron-app",
  "version": "1.0.2",
  "description": "CA OFFLINE APP",
  "main": "main.js",
  "icon": "./assets/cyphersol-icon.png",
  "scripts": {
    "start_": "powershell -Command \"Start-Process cmd -ArgumentList '/k cd /d \\\"C:\\Users\\admin\\Desktop\\CA-Offline\\frontend\\\" && npm run electron' -Verb runAs\"",
    "start": "npm run electron",
    "electron": "electron main.js",
    "start:fastapi": "cd ../ && uvicorn backend.main:app --reload --port 7500",
    "start:react": "cd react-app && npm start",
    "start:electron": "cross-env NODE_ENV=development wait-on http://localhost:3000 && electron main.js",
    "start-all": "cross-env NODE_ENV=development concurrently \"npm run start:fastapi\" \"npm run start:react\" \"npm run start:electron\"",
    "build": "npx rimraf dist && cross-env NODE_ENV=production npm run build:react && npm run build:electron",
    "build:react": "cd react-app && npm run build",
    "build:electron": "electron-builder",
    "deploy": "electron-builder --publish always",
    "release": "npm run build && npm run deploy",
    "test": "npx mocha test/**/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "mocha": "^11.1.0",
    "rimraf": "^5.0.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.electron.electronapp",
    "productName": "Cyphersol",
    "icon": "assets/cyphersol-icon.ico",
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Shama-Cyphersol",
      "repo": "ca-offline-suite",
      "private": true,
      "releaseType": "release"
    },
    "files": [
      "**/*",
      "react-app/build/**/*",
      "!../backend/**/*",
      "env/**/*",
      "!react-app/build/static/js/*.map",
      "!react-app/node_modules",
      "!backend/__pycache__",
      "!env/bin/python3",
      "package.json",
      "media/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/main",
        "to": "backend/main"
      },
      {
        "from": "media",
        "to": "media",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "drizzle.config.js",
        "to": "drizzle.config.js"
      },
      {
        "from": "gatewayServer/appsettings.json",
        "to": "appsettings.json"
      },
      {
        "from": "gatewayServer/gatewayService.exe",
        "to": "gatewayService.exe"
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "strictVerify": false,
      "electronUpdaterCompatibility": ">=2.15",
      "darkModeSupport": true
    },
    "win": {
      "icon": "assets/cyphersol-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false,
      "publisherName": "Cyphersol"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cyphersol",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "${productName}",
      "differentialPackage": true,
      "warningsAsErrors": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/cyphersol-icon.png"
    }
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bonjour": "^3.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto": "^1.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.2",
    "drizzle-orm": "^0.38.3",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "fast-xml-parser": "^4.5.1",
    "fs": "^0.0.1-security",
    "ip": "^2.0.1",
    "is-elevated": "^4.0.0",
    "keytar": "^7.9.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.1",
    "portscanner": "^2.2.0",
    "python-shell": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sudo-prompt": "^9.2.1",
    "systeminformation": "^5.25.11",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "xmldom": "^0.6.0"
  }
}
